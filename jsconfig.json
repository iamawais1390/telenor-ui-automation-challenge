{
  "compilerOptions": {
    "checkJs": false,
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2022"],
    "types": ["node"],
    "noEmit": true,
    "noImplicitAny": false,
    "skipLibCheck": true
  },
  "include": ["**/*.js"],
  "exclude": [
    "node_modules",
    "test-results",
    "playwright-report",
    "allure-results",
    "allure-report"
  ]
}
